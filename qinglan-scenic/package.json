{
  "name": "qinglan-scenic-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "dev:mobile": "pnpm --filter @scenic/mobile dev",
    "build:mobile": "pnpm --filter @scenic/mobile build:h5 && pnpm --filter @scenic/mobile build:mp-weixin",
    "dev:server": "pnpm --filter @scenic/server dev",
    "typecheck:mobile": "pnpm --filter @scenic/mobile typecheck",
    "test:mobile": "playwright test --config playwright.mobile.config.ts",
    "dev:ui": "vite --config packages/ui/examples/vite.config.ts",
    "build:ui": "vite build --config packages/ui/examples/vite.config.ts",
    "test:ui": "playwright test --config playwright.ui.config.ts",
    "dev": "pnpm --filter @scenic/visitor dev",
    "build": "pnpm --filter @scenic/visitor build",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "dev:ops": "pnpm --filter @scenic/ops dev",
    "build:ops": "pnpm --filter @scenic/ops build",
    "test:ops": "playwright test --config playwright.ops.config.ts",
    "dev:admin": "pnpm --filter @scenic/admin dev",
    "build:admin": "pnpm --filter @scenic/admin build",
    "test:admin": "vitest run --config apps/admin/vitest.config.ts && playwright test --config playwright.admin.config.ts",
    "assets:scenic-art": "node scripts/export-scenic-art.mjs",
    "dev:gate": "pnpm --filter @scenic/gate dev",
    "build:gate": "pnpm --filter @scenic/gate build",
    "typecheck:gate": "pnpm --filter @scenic/gate typecheck",
    "test:gate": "pnpm --filter @scenic/gate test && playwright test --config playwright.gate.config.ts",
    "check:gate-api": "node apps/gate/scripts/check-api.mjs",
    "dev:demo": "pnpm --filter @scenic/demo dev",
    "build:demo": "pnpm --filter @scenic/demo build",
    "assets:qr": "node scripts/export-scenic-qr.mjs",
    "test:platform": "vitest run tests/unit/platform.test.ts",
    "dev:all": "node scripts/dev-all.mjs",
    "test:display": "playwright test -c playwright.display.config.ts",
    "test:performance": "playwright test -c playwright.performance.config.ts",
    "dev:testing": "node scripts/dev-testing.mjs",
    "build:testing": "pnpm --filter @scenic/testing build",
    "typecheck:testing": "pnpm --filter @scenic/testing typecheck",
    "test:testing": "vitest run tests/unit/testing-panel.test.ts tests/unit/testing-special.test.ts tests/unit/testing-services.test.ts tests/unit/testing-handoff.test.ts tests/unit/testing-startup.test.ts tests/unit/testing-campus-special.test.ts tests/unit/testing-acceptance.test.ts && playwright test -c playwright.testing.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.3.0",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.5",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "qrcode": "^1.5.4",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.0.6"
  }
}
