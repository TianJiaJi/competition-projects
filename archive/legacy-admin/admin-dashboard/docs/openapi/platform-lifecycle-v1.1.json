{
  "openapi": "3.1.0",
  "info": {
    "title": "六端运行补充契约：模拟员工、公告、审核检测与遥感设备",
    "version": "1.1.0",
    "description": "本文件准确覆盖2026-09-13新增的模拟员工接口和公告列表，不替代尚未完成迁移的全量OpenAPI。完整当前地址清单见implementation/六端当前接口与交付记录.md。两种大屏公开读无需账号；小数仅展示格式化。"
  },
  "servers": [
    {
      "url": "http://localhost:8787/api/v1"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/demo/employees": {
      "get": {
        "summary": "查询当前运行的模拟员工开关",
        "description": "管理员身份。未配置时 enabled=true。",
        "parameters": [
          {
            "name": "X-Run-Id",
            "in": "header",
            "schema": {
              "type": "string"
            },
            "description": "运行ID，省略跟随当前展示运行"
          }
        ],
        "responses": {
          "200": {
            "description": "统一响应",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/EmployeeSettings"
                    },
                    "meta": {
                      "$ref": "#/components/schemas/Meta"
                    }
                  },
                  "required": [
                    "data",
                    "meta"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "参数无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "需要登录",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "权限不足",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "版本或幂等冲突",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "410": {
            "description": "运行失效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "启停模拟员工处置",
        "description": "管理员身份。按业务时间30—60秒领取未分配任务，再过2—5分钟反馈完成；待审批OA阻止完成，人工任务不接管。关闭保留已领取任务，重新开启后恢复推进。不得直接改监测数值。",
        "parameters": [
          {
            "name": "X-Run-Id",
            "in": "header",
            "schema": {
              "type": "string"
            },
            "description": "运行ID，省略跟随当前展示运行"
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmployeeSettings"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "统一响应",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/EmployeeSettings"
                    },
                    "meta": {
                      "$ref": "#/components/schemas/Meta"
                    }
                  },
                  "required": [
                    "data",
                    "meta"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "参数无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "需要登录",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "权限不足",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "版本或幂等冲突",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "410": {
            "description": "运行失效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/notices": {
      "get": {
        "summary": "获取本运行当前有效且当前身份可见的公告",
        "description": "业务时间达到expiresAt即不返回；游客仅public，员工可见internal。管理员历史集合保留到期项。暂停回放不推进有效期。",
        "parameters": [
          {
            "name": "X-Run-Id",
            "in": "header",
            "schema": {
              "type": "string"
            },
            "description": "运行ID，省略跟随当前展示运行"
          }
        ],
        "responses": {
          "200": {
            "description": "统一响应",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "items": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/Notice"
                          }
                        }
                      },
                      "required": [
                        "items"
                      ]
                    },
                    "meta": {
                      "$ref": "#/components/schemas/Meta"
                    }
                  },
                  "required": [
                    "data",
                    "meta"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "参数无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "需要登录",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "权限不足",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "版本或幂等冲突",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "410": {
            "description": "运行失效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/admin/moderation/check": {
      "post": {
        "summary": "检测游客言论：消息重新检测或独立文本试测",
        "description": "仅管理员。消息检测结合原聊天室上下文，违规可自动撤回；独立文本试测不发布消息、不修改已有消息。异步结果在管理员审核列表查询。失败进入retry，不能视为通过。",
        "parameters": [
          {
            "name": "X-Run-Id",
            "in": "header",
            "schema": {
              "type": "string"
            },
            "description": "运行ID，省略跟随当前展示运行"
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "type": "object",
                    "required": [
                      "text"
                    ],
                    "properties": {
                      "text": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2000
                      }
                    },
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "required": [
                      "messageId",
                      "expectedVersion"
                    ],
                    "properties": {
                      "messageId": {
                        "type": "string"
                      },
                      "expectedVersion": {
                        "type": "integer",
                        "minimum": 1
                      }
                    },
                    "additionalProperties": false
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "统一响应",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/ModerationTask"
                    },
                    "meta": {
                      "$ref": "#/components/schemas/Meta"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/public/devices": {
      "get": {
        "summary": "园区遥感设备统一模拟快照",
        "description": "source=mock；按运行ID、设备ID、5业务分钟时间片确定在线/异常/离线状态，离线value=null。数值来自共享运行。",
        "security": [],
        "responses": {
          "200": {
            "description": "统一响应",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "data": {
                      "type": "object",
                      "required": [
                        "source",
                        "runId",
                        "revision",
                        "checkedAt",
                        "items"
                      ],
                      "properties": {
                        "source": {
                          "const": "mock"
                        },
                        "runId": {
                          "type": "string"
                        },
                        "revision": {
                          "type": "integer"
                        },
                        "checkedAt": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "items": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "required": [
                              "id",
                              "name",
                              "state",
                              "value"
                            ],
                            "properties": {
                              "id": {
                                "type": "string"
                              },
                              "name": {
                                "type": "string"
                              },
                              "state": {
                                "enum": [
                                  "online",
                                  "offline",
                                  "abnormal"
                                ]
                              },
                              "value": {
                                "type": [
                                  "number",
                                  "null"
                                ]
                              },
                              "unit": {
                                "type": "string"
                              },
                              "checkedAt": {
                                "type": "string",
                                "format": "date-time"
                              }
                            }
                          }
                        }
                      }
                    },
                    "meta": {
                      "$ref": "#/components/schemas/Meta"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/admin/devices": {
      "get": {
        "summary": "园区遥感设备统一模拟快照",
        "description": "source=mock；按运行ID、设备ID、5业务分钟时间片确定在线/异常/离线状态，离线value=null。数值来自共享运行。",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "统一响应",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "data": {
                      "type": "object",
                      "required": [
                        "source",
                        "runId",
                        "revision",
                        "checkedAt",
                        "items"
                      ],
                      "properties": {
                        "source": {
                          "const": "mock"
                        },
                        "runId": {
                          "type": "string"
                        },
                        "revision": {
                          "type": "integer"
                        },
                        "checkedAt": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "items": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "required": [
                              "id",
                              "name",
                              "state",
                              "value"
                            ],
                            "properties": {
                              "id": {
                                "type": "string"
                              },
                              "name": {
                                "type": "string"
                              },
                              "state": {
                                "enum": [
                                  "online",
                                  "offline",
                                  "abnormal"
                                ]
                              },
                              "value": {
                                "type": [
                                  "number",
                                  "null"
                                ]
                              },
                              "unit": {
                                "type": "string"
                              },
                              "checkedAt": {
                                "type": "string",
                                "format": "date-time"
                              }
                            }
                          }
                        }
                      }
                    },
                    "meta": {
                      "$ref": "#/components/schemas/Meta"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Meta": {
        "type": "object",
        "properties": {
          "requestId": {
            "type": "string"
          },
          "generatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "runId": {
            "type": "string"
          },
          "revision": {
            "type": "integer"
          }
        },
        "required": [
          "requestId",
          "generatedAt"
        ]
      },
      "EmployeeSettings": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean"
          }
        },
        "required": [
          "enabled"
        ]
      },
      "Notice": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "audience": {
            "type": "string",
            "enum": [
              "public",
              "internal"
            ]
          },
          "active": {
            "type": "boolean"
          },
          "suppressed": {
            "type": "boolean"
          },
          "eventId": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "title",
          "body",
          "audience",
          "active"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ]
          },
          "meta": {
            "$ref": "#/components/schemas/Meta"
          }
        },
        "required": [
          "error",
          "meta"
        ]
      },
      "ModerationTask": {
        "type": "object",
        "required": [
          "id",
          "status",
          "version"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "messageId": {
            "type": "string"
          },
          "messageVersion": {
            "type": "integer"
          },
          "sample": {
            "type": "boolean"
          },
          "text": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "version": {
            "type": "integer"
          },
          "reason": {
            "type": "string"
          },
          "error": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "ruleVersions": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "decision": {
            "type": "string",
            "enum": [
              "pass",
              "violation",
              "review"
            ]
          }
        }
      }
    }
  }
}
