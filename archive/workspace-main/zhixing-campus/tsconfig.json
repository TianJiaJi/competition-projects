{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"],
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": [
    "apps/**/*.ts",
    "packages/**/*.ts",
    "packages/**/*.vue",
    "scenario/**/*.ts",
    "tests/**/*.ts",
    "*.ts",
    "apps/**/*.vue"
  ],
  "exclude": ["apps/mobile", "**/node_modules", "packages/ui/examples"]
}
