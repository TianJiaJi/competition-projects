{
  "name": "zhixing-campus",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:public": "pnpm --filter @scene/public dev",
    "dev:ops": "pnpm --filter @scene/ops dev",
    "dev:admin": "pnpm --filter @scene/admin dev",
    "dev:staff": "pnpm --filter @scene/staff dev",
    "dev:mobile": "pnpm --filter @scene/mobile dev",
    "dev:ui": "pnpm --filter @scene/preview dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "vue-tsc --noEmit && pnpm --filter @scene/mobile typecheck",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "assets:mobile": "node scripts/mobile-icons.mjs",
    "dev:demo": "node scripts/demo-run.mjs",
    "demo:start": "node scripts/demo-run.mjs",
    "demo:build": "pnpm --filter @scene/public --filter @scene/ops --filter @scene/mobile --filter @scene/staff --filter @scene/admin --filter @scene/demo-app build",
    "demo:serve": "node scripts/demo-run.mjs --static",
    "demo:assets": "node scripts/demo-assets.mjs && node scripts/demo-materials.mjs",
    "test:demo": "playwright test --config playwright.demo.config.ts",
    "test:demo:static": "DEMO_STATIC=1 playwright test --config playwright.demo.config.ts",
    "demo:service": "node scripts/demo-service.mjs",
    "test:service": "node --test tests/service/*.test.mjs",
    "demo:materials": "node scripts/demo-materials.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.3.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "three": "^0.180.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^3.2.4",
    "vue": "^3.5.21",
    "vue-tsc": "^3.0.6",
    "prettier": "3.6.2"
  }
}
